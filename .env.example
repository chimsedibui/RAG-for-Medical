# --- Data -------------------------------------------------------------
DATA_DIR=../data
HF_TOKEN=                      # required: ViBioMIR returns 401 without it
HF_DATASET=AIGuruTinix/ViBioMIR

# --- Crawl ------------------------------------------------------------
CRAWL_WORKERS=384
CRAWL_PER_DOMAIN_DELAY=0.3     # seconds between requests to the same host
CRAWL_TIMEOUT=30
CRAWL_RESPECT_ROBOTS=true

# --- Chunking ---------------------------------------------------------
CHUNK_MAX_TOKENS=220           # child chunk (retrieval unit), whitespace tokens
CHUNK_OVERLAP_TOKENS=40
PARENT_MAX_TOKENS=700          # parent/section window returned as chunk_text

# --- Models (all must be open weights, <=15B, released before 2026-08-01) --
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cuda
# Optional local OpenAI-compatible LLM (vLLM) for cross-lingual query expansion
LLM_BASE_URL=http://localhost:8001/v1   # llm/serve.sh; leave empty to disable query expansion
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3-4b

# --- Qdrant (docker compose up -d qdrant) --------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
QDRANT_QUANTIZE=true

# --- Retrieval --------------------------------------------------------
BM25_CANDIDATES=100
DENSE_CANDIDATES=100
RRF_K=60
RERANK_CANDIDATES=60
STRATIFY=true                  # retrieve per language (vi/en/zh), then fuse by rank
PER_STRATUM=30                 # candidates kept per language before fusion
DOC_MIN=1
DOC_MAX=8
DOC_REL_THRESHOLD=0.55         # keep docs scoring >= thr * best doc score (tune on dev for F2)
CHUNK_MAX_PER_DOC=3
CHUNK_REL_THRESHOLD=0.6

# --- Cross-source consensus + diversification ----------------------------
CONSENSUS=true
AGREE_THETA=0.62               # cosine of best chunks; ~99th pct of random chunk-pair cosine for bge-m3
AGREE_REL_MIN=0.3
AGREE_ALPHA=0.3
HOST_CAP=2                     # max docs per host in the final list
DEDUPE_CLUSTERS=false          # one doc per near-duplicate cluster (may cost recall)
